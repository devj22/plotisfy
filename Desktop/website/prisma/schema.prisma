generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Property {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  slug                String   @unique
  propertyCode        String
  title               String
  status              String
  featured            Boolean  @default(false)
  published           Boolean  @default(false)
  location            String
  village             String
  taluka              String
  district            String
  lat                 Float
  lng                 Float
  priceTotal          Float
  pricePerSqft        Float
  areaSqft            Float
  areaGuntha          Float
  areaAcre            Float
  zoningType          String
  titleClarity        String
  roadAccess          Boolean
  gallery             String   @default("[]")
  brochure            String?
  highlights          String   @default("[]")
  nearbyLandmarks     String   @default("[]")
  investmentReasoning String   @default("")
  whyThisProperty     String   @default("")
  seoTitle            String?
  seoDescription      String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Blog {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  title          String
  slug           String   @unique
  excerpt        String
  content        String   @default("")
  author         String
  category       String
  tags           String   @default("[]")
  featuredImage  String?
  published      Boolean  @default(false)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model GatedProject {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  slug        String   @unique
  title       String
  description String   @default("")
  location    String
  developer   String   @default("")
  totalUnits  Int      @default(0)
  priceMin    Float    @default(0)
  priceMax    Float    @default(0)
  amenities   String   @default("[]")
  gallery     String   @default("[]")
  status      String   @default("coming_soon")
  featured    Boolean  @default(false)
  published   Boolean  @default(false)
  brochure    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Deal {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  title         String
  description   String    @default("")
  propertySlug  String    @default("")
  originalPrice Float     @default(0)
  dealPrice     Float     @default(0)
  validUntil    DateTime?
  image         String?
  badge         String    @default("")
  published     Boolean   @default(false)
  featured      Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Lead {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  name               String
  phone              String
  email              String   @default("")
  locationPreference String   @default("")
  budgetRange        String   @default("")
  message            String   @default("")
  leadStatus         String   @default("new")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}
